<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <organization>
        <name>Openkoda</name>
        <url>https://openkoda.com/</url>
    </organization>

    <parent>
        <groupId>com.openkoda</groupId>
        <artifactId>openkoda-app</artifactId>
        <version>1.7.2-SNAPSHOT</version>
        <relativePath>../openkoda-app</relativePath>
    </parent>

    <artifactId>openkoda</artifactId>

    <profiles>
        <profile>
            <id>development-module</id>
            <dependencies>
                <dependency>
                    <groupId>com.openkoda.openkoda-extensions</groupId>
                    <artifactId>openkoda-development-module</artifactId>
                    <version>1.7.2-SNAPSHOT</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                        </exclusion>
                    </exclusions>                    
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>documents</id>
            <dependencyManagement></dependencyManagement>
            <dependencies>
                <dependency>
                    <groupId>com.openkoda.openkoda-extensions</groupId>
                    <artifactId>documents</artifactId>
                    <version>1.7.2-SNAPSHOT</version>         
                    <exclusions>
                        <exclusion>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                        </exclusion>
                    </exclusions>                              
                </dependency>
            </dependencies>
        </profile>        
        <profile>
            <id>cloud</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <archive>
                                <manifestEntries>
                                    <OK-GIT_BRANCH>${git.branch}</OK-GIT_BRANCH>
                                    <OK-GIT_COMMIT_ID>${git.commit.id.abbrev}</OK-GIT_COMMIT_ID>
                                    <OK-TIME>${maven.build.timestamp}</OK-TIME>
                                    <OK-BUILD_NUMBER>${build.number}</OK-BUILD_NUMBER>
                                    <OK-HOSTNAME>${git.build.host}</OK-HOSTNAME>
                                    <OK-ARTIFACT>${project.artifactId}</OK-ARTIFACT>
                                    <OK-GROUP>${project.groupId}</OK-GROUP>
                                    <OK-VERSION>${project.version}</OK-VERSION>
                                    <OK-CLASSIFIER>${build.classifier}</OK-CLASSIFIER>
                                </manifestEntries>
                            </archive>
                            <classifier>cloud</classifier>
                            <detail>false</detail>
                            <excludes>
                                <exclude>application-dev*.properties</exclude>
                                <exclude>**/LiveSystemServices.class</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- configure JAR build -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <OK-GIT_BRANCH>${git.branch}</OK-GIT_BRANCH>
                            <OK-GIT_COMMIT_ID>${git.commit.id.abbrev}</OK-GIT_COMMIT_ID>
                            <OK-TIME>${maven.build.timestamp}</OK-TIME>
                            <OK-BUILD_NUMBER>${build.number}</OK-BUILD_NUMBER>
                            <OK-HOSTNAME>${git.build.host}</OK-HOSTNAME>
                            <OK-ARTIFACT>${project.artifactId}</OK-ARTIFACT>
                            <OK-GROUP>${project.groupId}</OK-GROUP>
                            <OK-VERSION>${project.version}</OK-VERSION>
                            <OK-CLASSIFIER>${build.classifier}</OK-CLASSIFIER>
                        </manifestEntries>
                    </archive>
                    <classifier></classifier>
                    <detail>false</detail>
                    <excludes>
                        <exclude>application-dev*.properties</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <configuration>
                            <verbose>false</verbose>
                            <offline>true</offline>
                            <generateGitPropertiesFile>false</generateGitPropertiesFile>
                            <skipPoms>false</skipPoms>
                            <replacementProperties>
                                <replacement>
                                    <property>git.branch</property>
                                    <token>origin/</token>
                                    <value />
                                </replacement>
                                <replacement>
                                    <property>git.branch</property>
                                    <token>/</token>
                                    <value>_</value>
                                </replacement>
                            </replacementProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <layout>ZIP</layout>
                    <outputDirectory>build</outputDirectory>
                    <attach>false</attach>
                    <!--<classifier>EXEC</classifier>-->
                    <excludes>
                        <exclude>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                        </exclude>
                    </excludes>
                    <additionalProperties>
                        <git.branch>${git.branch}</git.branch>
                        <git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
                        <build.number>${build.number}</build.number>
                        <hostname>${git.build.host}</hostname>
                        <classifier>${build.classifier}</classifier>
                    </additionalProperties>
                </configuration>
                <executions>
                    <!--<execution>
                        <id>ok-build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <additionalProperties>
                                <git.branch>${git.branch}</git.branch>
                                <git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
                                <build.number>${build.number}</build.number>
                                <hostname>${git.build.host}</hostname>
                            </additionalProperties>
                        </configuration>
                    </execution>-->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <additionalProperties>
                                <git.branch>${git.branch}</git.branch>
                                <git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
                                <build.number>${build.number}</build.number>
                                <hostname>${git.build.host}</hostname>
                                <classifier>${build.classifier}</classifier>
                            </additionalProperties>
                            <!--<finalName>${finalRepackagedName}</finalName>-->
                        </configuration>
                    </execution>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <attach>false</attach>
                            <classifier>${profile.classifier}</classifier>
                            <excludes>
                                <exclude>
                                    <groupId>com.openkoda</groupId>
                                    <artifactId>openkoda</artifactId>
                                </exclude>
                            </excludes>
                            <additionalProperties>
                                <git.branch>${git.branch}</git.branch>
                                <git.commit.id.abbrev>${git.commit.id.abbrev}</git.commit.id.abbrev>
                                <build.number>${build.number}</build.number>
                                <hostname>${git.build.host}</hostname>
                                <classifier>${profile.classifier}</classifier>
                            </additionalProperties>
                            <finalName>${finalRepackagedName}</finalName>
                        </configuration>
                    </execution>
                    <!--<execution>
                        <id>ok-repackage-cloud</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <attach>false</attach>
                            <classifier>cloud</classifier>
                            <excludes>
                                <exclude>
                                    <groupId>com.openkoda</groupId>
                                    <artifactId>openkoda</artifactId>
                                </exclude>
                            </excludes>
                            <finalName>${project.artifactId}-${project.version}-EXEC</finalName>
                        </configuration>
                    </execution>-->
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>

                <executions>
                    <execution>
                        <id>rename-boot-cloud-jar</id>
                        <phase>package</phase> <!-- Choose the appropriate phase -->
                        <configuration>
                            <target>
                                <move
                                    file="${project.basedir}/build/${finalRepackagedName}${profile.classifier-}.jar"
                                    tofile="${project.basedir}/build/${finalRepackagedName}.jar" />
                            </target>
                            <failOnError>false</failOnError>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <installAtEnd>false</installAtEnd>
                </configuration>
                <executions>
                    <execution>
                        <id>default-install</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>install-jar</id>
                        <phase>install</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                            <version>${version}</version>
                            <classifier>${profile.classifier}</classifier>
                            <packaging>jar</packaging>
                            <file>
                                ${project.basedir}/target/${artifactId}-${version}${profile.classifier-}.jar</file>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-boot-jars</id>
                        <phase>install</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                            <version>${version}</version>
                            <classifier>${boot.classifier}</classifier>
                            <packaging>jar</packaging>
                            <file>
                                ${project.basedir}/build/${finalRepackagedName}.jar</file>
                        </configuration>
                    </execution>
                </executions>

            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- sets the repoUrl property to the correct repository
                        depending on the type of version -->
                        <id>build-deploy-url</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <configuration>
                            <name>repoUrl</name>
                            <value>${project.version}</value>
                            <regex>.*-SNAPSHOT</regex>
                            <replacement>
                                ${project.distributionManagement.snapshotRepository.url}</replacement>
                            <failIfNoMatch>
                                ${project.distributionManagement.repository.url}</failIfNoMatch>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.3</version><!--$NO-MVN-MAN-VER$-->
                <executions>
                    <execution>
                        <id>default-deploy</id>
                        <phase>none</phase>
                    </execution>
                     <execution>
                        <id>deploy-jars-snapshot</id>
                        <goals>
                            <goal>deploy-file</goal>
                        </goals>
                        <phase>deploy</phase>
                        <configuration>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                            <version>${version}</version>
                            <classifier>${profile.classifier}</classifier>
                            <packaging>jar</packaging>
                            <repositoryId>
                                ${project.distributionManagement.snapshotRepository.id}</repositoryId>
                            <url>
                                ${project.distributionManagement.snapshotRepository.url}</url>
                            <file>
                                ${project.basedir}/target/${artifactId}-${version}${profile.classifier-}.jar</file>
                            <skip>releases</skip>
                        </configuration>

                    </execution>
                    <execution>
                        <id>deploy-jars-release</id>
                        <goals>
                            <goal>deploy-file</goal>
                        </goals>
                        <phase>deploy</phase>
                        <configuration>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                            <version>${version}</version>
                            <classifier>${boot.classifier}</classifier>
                            <packaging>jar</packaging>
                            <repositoryId>
                                ${project.distributionManagement.repository.id}</repositoryId>
                            <url>
                                ${project.distributionManagement.repository.url}</url>
                            <file>
                                ${project.basedir}/target/${artifactId}-${version}${profile.classifier-}.jar</file>
                            <skip>snapshots</skip>
                        </configuration>

                    </execution>
                    <execution>
                        <id>deploy-boot-jars-snapshot</id>
                        <goals>
                            <goal>deploy-file</goal>
                        </goals>
                        <phase>deploy</phase>
                        <configuration>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                            <version>${version}</version>
                            <classifier>${boot.classifier}</classifier>
                            <packaging>jar</packaging>
                            <repositoryId>
                                ${project.distributionManagement.snapshotRepository.id}</repositoryId>
                            <url>
                                ${project.distributionManagement.snapshotRepository.url}</url>
                            <file>
                                ${project.basedir}/build/${finalRepackagedName}.jar</file>
                            <skip>releases</skip>
                        </configuration>

                    </execution>
                    <execution>
                        <id>deploy-boot-jars-release</id>
                        <goals>
                            <goal>deploy-file</goal>
                        </goals>
                        <phase>deploy</phase>
                        <configuration>
                            <groupId>com.openkoda</groupId>
                            <artifactId>openkoda</artifactId>
                            <version>${version}</version>
                            <classifier>${boot.classifier}</classifier>
                            <packaging>jar</packaging>
                            <repositoryId>
                                ${project.distributionManagement.repository.id}</repositoryId>
                            <url>
                                ${project.distributionManagement.repository.url}</url>
                            <file>
                                ${project.basedir}/build/${finalRepackagedName}.jar</file>
                            <skip>snapshots</skip>
                        </configuration>

                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>